{
  "name": "arq_tw_appium",
  "version": "1.0.0",
  "description": "Mobile test automation archetype with Appium + WebdriverIO + Cucumber + Allure",
  "main": "index.js",
  "scripts": {
    "bdd:clean": "node -e \"require('fs').rmSync('features/support/.features_gen',{recursive:true,force:true}); console.log('[bdd:clean] OK')\"",
    "bdd:gen": "cross-env FEATURES_SRC=features FEATURES_OUT=features/support/.features_gen node features/support/expand-csv-examples.js",
    "wdio": "wdio run wdio.conf.ts",
    "pretest": "npm run bdd:gen",
    "test": "wdio run wdio.conf.ts",
    "posttest": "npm run bdd:clean",
    "pretest:android": "npm run bdd:gen",
    "test:android": "wdio run wdio.conf.ts",
    "posttest:android": "npm run bdd:clean",
    "pretest:android:local": "npm run bdd:gen",
    "test:android:local": "wdio run wdio.conf.ts",
    "posttest:android:local": "npm run bdd:clean",
    "pretest:android:ci": "npm run bdd:gen",
    "test:android:ci": "wdio run wdio.conf.ts",
    "posttest:android:ci": "npm run bdd:clean",
    "test:ios": "cross-env TARGET=ios npm run test",
    "test:tags": "npm run test",
    "test:ios:tags": "cross-env TARGET=ios npm run test",
    "test:android:tags": "npm run test:android",
    "appium:android": "appium --address 127.0.0.1 --allow-insecure uiautomator2:chromedriver_autodownload,uiautomator2:adb_shell",
    "evidence:word": "node features/support/generate-word-report.js",
    "allure:report": "npx --yes allure generate \"allure-results\" --clean -o \"allure-report\"",
    "allure:open": "npx --yes allure open \"allure-report\"",
    "report": "npm run allure:report && npm run allure:open"
  },
  "repository": {
    "type": "git",
    "url": "git+https://gitlab.com/thoughtworks9030411/arq_tw_appium.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://gitlab.com/thoughtworks9030411/arq_tw_appium/issues"
  },
  "homepage": "https://gitlab.com/thoughtworks9030411/arq_tw_appium#readme",
  "devDependencies": {
    "@cucumber/cucumber": "^12.2.0",
    "@types/node": "^20.19.11",
    "@wdio/allure-reporter": "^9.19.1",
    "@wdio/appium-service": "^9.19.1",
    "@wdio/cli": "^9.19.1",
    "@wdio/cucumber-framework": "^9.19.1",
    "@wdio/local-runner": "^9.19.1",
    "@wdio/spec-reporter": "^9.19.1",
    "allure-commandline": "^2.34.1",
    "appium": "^3.0.0",
    "appium-uiautomator2-driver": "^5.0.0",
    "chromedriver": "^143.0.3",
    "cross-env": "^10.0.0",
    "csv-parse": "^6.1.0",
    "glob": "^11.0.3",
    "jszip": "^3.10.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2"
  }
}
